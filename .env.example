# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# AWS
AWS_PROFILE=default
AWS_REGION=us-east-1

# Data sources (optional, used by connectors)
SOURCE_MONGODB_URI=mongodb://localhost:27017/mydb
SOURCE_FILESYSTEM_PATH=/path/to/data

# Logging
LOG_LEVEL=INFO

# Migration settings
MIGRATION_NAME=my-migration
DRY_RUN=false
